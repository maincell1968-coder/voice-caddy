{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ SALUTE INFRASTRUTTURA & LIVELLI DI SERVIZIO (ZERO-TOKEN MONITORING)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "OFFLINE" }, "1": { "color": "green", "text": "ONLINE" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Stato Server (Streamlit 8501)",
      "type": "stat",
      "targets": [{ "expr": "voice_caddy_server_status_up", "format": "time_series", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 250 }, { "color": "red", "value": 600 }] },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Latenza HTTP Server",
      "type": "gauge",
      "targets": [{ "expr": "voice_caddy_server_latency_milliseconds", "format": "time_series", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Errori Applicativi 5xx (Real-Time)",
      "type": "stat",
      "targets": [{ "expr": "voice_caddy_http_5xx_errors_total", "format": "time_series", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "super-light-blue" },
          "mappings": [{ "options": { "0": { "color": "green", "text": "0 Tokens (Gratuito al 100%)" } }, "type": "value" }]
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Consumo Token LLM nel Monitoraggio",
      "type": "stat",
      "targets": [{ "expr": "voice_caddy_llm_tokens_used", "format": "time_series", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "🏌️ FLUSSO UTENTE DOPPIO: TELEGRAM ➡️ COMPLETAMENTO BROWSER",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 40 }, { "color": "green", "value": 70 }] },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "id": 5,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "title": "Tasso di Completamento Funnel (%)",
      "type": "gauge",
      "targets": [{ "expr": "voice_caddy_funnel_completion_rate_percent", "format": "time_series", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none", "lineWidth": 1 }
        }
      },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 7 },
      "id": 6,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "showUnfilled": true },
      "title": "Funnel Conversion Steps (Volumi Totali)",
      "type": "bargauge",
      "targets": [
        { "expr": "voice_caddy_telegram_sessions_started_total", "legendFormat": "1. Avvio su Telegram", "refId": "A" },
        { "expr": "voice_caddy_telegram_sessions_completed_total", "legendFormat": "2. Giro Concluso su Telegram", "refId": "B" },
        { "expr": "voice_caddy_browser_completions_total", "legendFormat": "3. Completamento & Analisi su Browser", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "⛳ GOLF INTELLIGENCE & STATISTICHE AVANZATE",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "none" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 15 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Giri Storici Analizzati",
      "type": "stat",
      "targets": [{ "expr": "voice_caddy_golf_rounds_evaluated_total", "format": "time_series", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "none" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 15 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Score Medio Giocatori",
      "type": "stat",
      "targets": [{ "expr": "voice_caddy_golf_avg_score", "format": "time_series", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 15 },
      "id": 9,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Green in Regolazione (GIR %)",
      "type": "stat",
      "targets": [{ "expr": "voice_caddy_golf_avg_gir_percent", "format": "time_series", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent" }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 15 },
      "id": 10,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Fairway Presi dal Tee (FIR %)",
      "type": "stat",
      "targets": [{ "expr": "voice_caddy_golf_avg_fir_percent", "format": "time_series", "refId": "A" }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["voice-caddy", "zero-cost", "telemetry", "golf"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "Voice Caddy Pro - Zero-Cost Telemetry & Session Funnel",
  "version": 1
}
