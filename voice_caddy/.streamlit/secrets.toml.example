# ==============================================================================
# SECRETS CONFIGURATION — VOICE CADDY PRO (STREAMLIT)
# ==============================================================================
#
# Per usare Supabase in locale:
# 1. Rinomina o copia questo file in: .streamlit/secrets.toml
# 2. Inserisci il tuo URL Supabase e la tua chiave API (anon o service_role)
# 3. Riavvia l'applicazione Streamlit
#
# Su Streamlit Community Cloud:
# Incolla queste chiavi nella sezione: Settings -> Secrets della tua dashboard web.
# ==============================================================================

# URL del tuo progetto Supabase (trovabile in Project Settings -> API)
SUPABASE_URL = "https://tuo-project-id.supabase.co"

# Chiave API (consigliata: 'anon' 'public' se hai applicato le policy RLS)
SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tuo-token-qui..."

# Altre chiavi già usate dall'app (opzionali):
# GROQ_API_KEY = "gsk_..."
# TELEGRAM_BOT_TOKEN = "..."
